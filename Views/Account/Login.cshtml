@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}
<div class="form-page">
    <div class="form-card">
        <span class="eyebrow">ACESSO</span>
        <h1>Entrar</h1>
        <p class="muted">Use seu e-mail e senha cadastrados.</p>
        <form asp-action="Login" method="post">
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="validation"></div>
            <label asp-for="Email"></label>
            <input asp-for="Email" type="email" autocomplete="email" />
            <span asp-validation-for="Email" class="field-error"></span>

            <label asp-for="Senha"></label>
            <input asp-for="Senha" autocomplete="current-password" />
            <span asp-validation-for="Senha" class="field-error"></span>

            <label class="checkbox"><input asp-for="LembrarDeMim" /> @Html.DisplayNameFor(m => m.LembrarDeMim)</label>
            <button class="btn primary full" type="submit">Entrar</button>
        </form>
        <p class="form-footer">Ainda não possui conta? <a asp-action="Register">Cadastre-se</a></p>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
