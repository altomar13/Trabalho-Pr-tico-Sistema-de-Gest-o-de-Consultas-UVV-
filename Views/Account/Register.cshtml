@model RegistroUsuarioViewModel
@{
    ViewData["Title"] = "Criar conta";
}
<div class="form-page">
    <div class="form-card">
        <span class="eyebrow">NOVO USUÁRIO</span>
        <h1>Criar conta</h1>
        <p class="muted">Preencha os dados abaixo para acessar o sistema.</p>
        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="validation"></div>
            <label asp-for="Nome"></label>
            <input asp-for="Nome" autocomplete="name" />
            <span asp-validation-for="Nome" class="field-error"></span>

            <label asp-for="Email"></label>
            <input asp-for="Email" type="email" autocomplete="email" />
            <span asp-validation-for="Email" class="field-error"></span>

            <label asp-for="Senha"></label>
            <input asp-for="Senha" autocomplete="new-password" />
            <span asp-validation-for="Senha" class="field-error"></span>

            <label asp-for="ConfirmarSenha"></label>
            <input asp-for="ConfirmarSenha" autocomplete="new-password" />
            <span asp-validation-for="ConfirmarSenha" class="field-error"></span>

            <button class="btn primary full" type="submit">Cadastrar</button>
        </form>
        <p class="form-footer">Já possui conta? <a asp-action="Login">Entrar</a></p>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
