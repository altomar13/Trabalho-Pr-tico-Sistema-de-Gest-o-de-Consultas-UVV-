@model Consulta
@{
    ViewData["Title"] = "Nova consulta";
}
<div class="form-page">
    <div class="form-card wide">
        <span class="eyebrow">CRUD · CREATE</span>
        <h1>Nova consulta</h1>
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="validation"></div>
            <label asp-for="Especialidade"></label>
            <input asp-for="Especialidade" placeholder="Ex.: Cardiologia" />
            <span asp-validation-for="Especialidade" class="field-error"></span>

            <label asp-for="DataHora"></label>
            <input asp-for="DataHora" type="datetime-local" />
            <span asp-validation-for="DataHora" class="field-error"></span>

            <label asp-for="Descricao"></label>
            <textarea asp-for="Descricao" rows="5" placeholder="Informe observações ou detalhes da consulta"></textarea>
            <span asp-validation-for="Descricao" class="field-error"></span>

            <div class="form-actions"><a class="btn secondary" asp-action="Index">Cancelar</a><button class="btn primary" type="submit">Salvar consulta</button></div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
